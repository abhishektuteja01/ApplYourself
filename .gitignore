# Deny by default, re-include deliberately.
#
# The previous version enumerated the private files it knew about, so anything
# new — profile/contacts.yaml, pipeline/<id>/notes.md, inbox/*.txt, a stray
# profile/*.docx — was staged by `git add -A` without a word. Every directory
# that holds user data now excludes its own contents, and the committed
# templates are re-included one line at a time.
#
# `dir/*` and not `dir/**`: git cannot re-include a file whose parent directory
# is excluded, so each level is excluded separately and re-included by name.

# =============================================================================
# profile/ — real experience, contacts, strategy, and the PII denylist itself.
# Committed: the *.example.* templates, the two rule files, and the three
# example_* vertical directories.
# =============================================================================
profile/*
!profile/*.example.yaml
!profile/*.example.txt
!profile/*.example.md
# The two Word templates cannot be a commented text file. Scrub after any Word
# save with scripts/scrub_example_templates.py; both are allowlisted in pii_scan.sh and
# guarded by tests/test_example_templates.py, which fails if either one grows
# text beyond its approved set or picks up an author in its core properties.
!profile/*.example.docx
!profile/de_ai_rules.yaml
!profile/sponsorship_rules.yaml
!profile/verticals/
profile/verticals/*
!profile/verticals/example_primary/
!profile/verticals/example_secondary/
!profile/verticals/example_tertiary/

# =============================================================================
# pipeline/ — application history: companies, scores, dates, and other people's
# names in outreach drafts. Strategy and PII both.
# =============================================================================
pipeline/*
!pipeline/.gitkeep

# =============================================================================
# inbox/ — raw JD clips; may carry confidential recruiter or company text.
# =============================================================================
inbox/*
!inbox/.gitkeep

# =============================================================================
# jobs/ — every parquet, shard and run report discovery/scoring regenerate.
# =============================================================================
jobs/*
!jobs/.gitkeep

# =============================================================================
# data/universe/*.local.csv — bulk ATS slug lists from a CC BY-NC source. The
# repo is MIT, so they stay local; only self-verified slugs go in the tracked
# <ats>.csv beside them. See data/universe/README.md.
# =============================================================================
data/universe/*.local.csv

# =============================================================================
# .apply_profile/ — the persistent Chrome profile /apply drives the browser
# with. Holds cookies and whatever a board sets during a fill.
# =============================================================================
.apply_profile/

# =============================================================================
# Other generated output
# =============================================================================
applications/
shortlist/
pipeline.md
top_scored_unapplied.md
top_scored_unapplied.csv
# Nightly discovery logs (scheduler job). The directory itself is committed via
# .gitkeep: launchd will not create the intermediate directory for
# StandardOutPath, so a fresh clone without logs/ means the agent fails to spawn
# with no log to say why. `/logs/*` rather than `/logs/`, or the re-include below
# cannot apply — git will not re-include a file whose parent is excluded.
/logs/*
!/logs/.gitkeep
# Fixed staging dir for Word/osascript PDF conversion (see /tailor, /cover-letter).
# Word's sandbox grant doesn't reliably persist across new per-job output dirs;
# converting through one unchanging folder keeps a single one-time grant valid.
.pdf_staging/

# =============================================================================
# Private working notes — live breakage tracker and backlog. They carry measured
# funnel counts, real lane names and local paths; versioned in the private bare
# repo, not here.
# =============================================================================
/HANDOFF.md
/publish.md
/test.md
/plan.md
/submit_plan.md
/debug_application.md
/onboarding_plan.md

# =============================================================================
# Python / uv / tooling
# =============================================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/

# NOTE: uv.lock is intentionally NOT ignored — committed for reproducibility.

# =============================================================================
# Editor / OS / agent-local
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
# Microsoft Word lock files (created when a docx is open in Word)
~$*
# Machine-local Claude Code permissions — was covered only by the user's global
# gitignore, so it was exposed on any fresh clone.
.claude/settings.local.json
