<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS only: launchd is the macOS scheduler. On Linux there is no launchd —
  run scripts/nightly_discovery.sh from cron or a systemd timer instead, at the
  same time this plist schedules below.

  The Label and paths below are filled in by the sed command in /onboarding's
  "Nightly discovery (macOS only)" section, which writes an installable copy
  into ~/Library/LaunchAgents/ and leaves this file untouched:

    LABEL=com.$USER.applyourself.discovery
    sed -e "s|__LABEL__|$LABEL|g" -e "s|__REPO__|$PWD|g" \
        scripts/launchagent.example.plist > ~/Library/LaunchAgents/$LABEL.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/$LABEL.plist

  Absolute paths are mandatory: launchd does not expand ~ or $HOME here.

  A LaunchAgent whose start time falls while the Mac is asleep does not run at
  wake by default — it is skipped until the next interval. Schedule a wake a few
  minutes before it (see /onboarding's "Nightly discovery (macOS only)"
  section):

    sudo pmset repeat wakeorpoweron MTWRFSU 22:25:00

  Verify:  launchctl print gui/$(id -u)/__LABEL__
  Remove:  launchctl bootout gui/$(id -u)/__LABEL__
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/nightly_discovery.sh</string>
  </array>

  <!-- 22:30 daily, five minutes after the pmset wake above. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- launchd's own capture of the wrapper's stdout/stderr. The wrapper writes
       its own per-run log to __REPO__/logs/discovery_<timestamp>.log. -->
  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.err.log</string>

  <!-- Background: lower I/O and CPU priority, so an overnight scrape does not
       compete with anything in the foreground. -->
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
