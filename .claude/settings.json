{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run verticals-check)",
      "Bash(uv run score:*)",
      "Bash(uv run track:*)",
      "Bash(uv run tailor-prep:*)",
      "Bash(uv run profile-extract:*)",
      "Bash(uv run apply prepare:*)",
      "Bash(uv run apply plan:*)",
      "Bash(uv run python -m src.score_cli:*)",
      "Bash(uv run python -m src.track_cli:*)",
      "Bash(./scripts/pii_scan.sh)",
      "Bash(uv run python scripts/scrub_example_templates.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(cmp:*)",
      "Bash(ls:*)",
      "Bash(sed -n:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/state_yaml_guard.sh",
            "statusMessage": "R10: checking state.yaml is not edited directly"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pii_gate.sh",
            "if": "Bash(git commit:*)",
            "timeout": 30,
            "statusMessage": "Running the PII gate over the index"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/r7_no_llm_in_src.sh",
            "timeout": 30,
            "statusMessage": "R7: checking src/ calls no LLM"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fixture_mirrors.sh",
            "timeout": 30,
            "statusMessage": "Checking the two verticals fixtures still match"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests_gate.sh",
            "timeout": 660,
            "statusMessage": "src/ changed: running the test suite"
          }
        ]
      }
    ]
  }
}
