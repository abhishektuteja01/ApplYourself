{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run verticals-check)",
      "Bash(uv run discovery-check)",
      "Bash(uv run discover-digest:*)",
      "Bash(uv run score:*)",
      "Bash(uv run track:*)",
      "Bash(uv run app:*)",
      "Bash(uv run profile-extract:*)",
      "Bash(uv run apply prepare:*)",
      "Bash(uv run apply plan:*)",
      "Bash(uv run apply learn:*)",
      "Bash(./scripts/pii_scan.sh)",
      "Bash(uv run python scripts/dev/scrub_example_templates.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(cmp:*)",
      "Bash(ls:*)",
      "Bash(sed -n:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(uv run config:*)",
      "Bash(uv run apply judge-pack:*)",
      "Bash(uv run apply judge-check:*)",
      "Bash(uv run apply-eval:*)"
    ],
    "ask": [
      "Bash(uv run apply run *--submit*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/state_yaml_guard.sh",
            "statusMessage": "R10: checking state.yaml is not edited directly"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirmed_guard.sh",
            "statusMessage": "Checking no .confirmed file is written"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pii_gate.sh",
            "if": "Bash(git commit:*)",
            "timeout": 30,
            "statusMessage": "Running the PII gate over the index"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/submit_ask.sh",
            "statusMessage": "Asking before any apply --submit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/r7_no_llm_in_src.sh",
            "timeout": 30,
            "statusMessage": "R7: checking src/ calls no LLM"
          }
        ]
      }
    ]
  }
}