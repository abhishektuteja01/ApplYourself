#!/usr/bin/env bash
# Blocks a push whose tracked files, or whose pushed commits, contain
# denylisted PII.
#
# Enable once per clone:  git config core.hooksPath .githooks
#   (core.hooksPath is local config and cannot be versioned, so a fresh clone
#    has no hook at all. The test suite covers the gate too, and CI runs it.)
# Bypass (do not):        git push --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# 1. The working tree's tracked files.
"$root/scripts/pii_scan.sh"

# 2. The two tracked .docx templates. pii_scan.sh allowlists them by name, so
#    neither its binary check nor its text scan reads them, and the -G pickaxe
#    below is text-only — git emits no diff lines for a .docx. Their entire
#    guard is this test file. CI runs it too, but CI runs after the push, by
#    which point the blob is public and reachable by SHA forever.
#    Fails closed: no uv means the check did not run, which is not a pass.
if ! command -v uv >/dev/null 2>&1; then
  printf 'pre-push: FAIL — uv not found, so the .docx template guard could not run.\n' >&2
  printf 'Those two files are allowlisted in pii_scan.sh; nothing else checks them.\n' >&2
  exit 1
fi
if ! (cd "$root" && uv run pytest tests/test_example_templates.py -q >/dev/null 2>&1); then
  printf 'pre-push: FAIL — profile/*.example.docx failed their guard.\n\n' >&2
  (cd "$root" && uv run pytest tests/test_example_templates.py -q 2>&1 | tail -20) >&2
  printf '\nDid you re-save one in Word? That stamps your name into the metadata.\n' >&2
  printf 'Regenerate: uv run python scripts/make_example_templates.py\n' >&2
  exit 1
fi

# 3. The commits actually being pushed. The scan above reads the index, so it
#    says nothing about a file that was clean at HEAD but carried PII three
#    commits ago — and pushing publishes every one of those blobs.
denylist="$root/profile/pii_denylist.txt"
[[ -f "$denylist" ]] || exit 0

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$denylist" \
  | sed -e 's/^~//' -e 's/[[:space:]]*$//' >"$patterns" || true
[[ -s "$patterns" ]] || exit 0

status=0
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [[ "$local_oid" =~ ^0+$ ]] && continue          # branch deletion
  if [[ "$remote_oid" =~ ^0+$ ]]; then
    range="$local_oid"                            # new branch: its own history
  else
    range="$remote_oid..$local_oid"
  fi
  # -G greps added/removed content across the range's diffs.
  hits=$(git log --oneline --pickaxe-regex -i -G "$(paste -sd'|' "$patterns")" \
           "$range" 2>/dev/null) || continue
  if [[ -n "$hits" ]]; then
    printf 'pre-push: FAIL — commits being pushed touch denylisted strings:\n\n%s\n\n' \
      "$hits" >&2
    printf 'These blobs become public on push and stay reachable by SHA.\n' >&2
    printf 'Rewrite the history (git filter-repo) before pushing.\n' >&2
    status=1
  fi
done

exit "$status"
