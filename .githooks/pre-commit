#!/usr/bin/env bash
# Blocks a commit that stages a .py file failing `ruff check` or
# `ruff format --check` or mypy, or a change under
# src/, tests/, scripts/, data/defaults/ or a profile example while the R7 scan or the test
# suite is red. Any other commit skips both.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass:                 git commit --no-verify
#
# Fail-open on a toolchain that is not set up yet. A fresh clone with no `uv`
# or no tests/ directory must not be blocked by a gate it cannot run.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 0
[ -d tests ] || exit 0
command -v uv >/dev/null 2>&1 || exit 0

if [ -n "$(git diff --cached --name-only -- '*.py' 2>/dev/null || true)" ]; then
  if ! LINT="$(uv run ruff check src tests scripts 2>&1)"; then
    {
      echo "pre-commit: FAIL — ruff check."
      echo
      printf '%s\n' "$LINT" | tail -30
    } >&2
    exit 1
  fi
  if ! FMT="$(uv run ruff format --check src tests scripts 2>&1)"; then
    {
      echo "pre-commit: FAIL — ruff format --check. Run: uv run ruff format src tests scripts"
      echo
      printf '%s\n' "$FMT" | tail -30
    } >&2
    exit 1
  fi
  if ! TYPES="$(uv run mypy 2>&1)"; then
    {
      echo "pre-commit: FAIL — mypy."
      echo
      printf '%s\n' "$TYPES" | tail -30
    } >&2
    exit 1
  fi
fi

WATCHED=(src tests 'profile/*.example.*' scripts data/defaults)
STAGED="$(git diff --cached --name-only -- "${WATCHED[@]}" 2>/dev/null || true)"
[ -n "$STAGED" ] || exit 0

if [ -x scripts/r7_scan.sh ] && ! scripts/r7_scan.sh "$root"; then
  exit 1
fi

RUNNER=(uv run pytest tests -q -x -n 3 --dist loadgroup)

OUT="$("${RUNNER[@]}" 2>&1)"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  {
    echo "pre-commit: FAIL — a watched path is staged and the suite is red."
    echo
    printf '%s\n' "$OUT" | tail -30
    echo
    echo "Fix the failure before committing. Full run: uv run pytest tests -q"
  } >&2
  exit 1
fi
exit 0
